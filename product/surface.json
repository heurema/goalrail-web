        },
        {
          "flag": "--scaffold <string>",
          "effect": "codex or claude-code; omit to report every supported scaffold"
        },
        {
          "flag": "--state-dir <string>",
          "effect": "Goalrail local state directory"
        }
      ]
    },
    {
